# Jeunese — environment template (Milestone 1)
# Copy to .env.local and fill values. Do not commit secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep true until legal + payment partners approve production invest.
NEXT_PUBLIC_DEMO_MODE=true

# Clerk (auth adapter) — leave empty for stub mode; never invent secret values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
